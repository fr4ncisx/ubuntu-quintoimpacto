## DATABASE ##
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Fill with postgres password
POSTGRES_DB=ubuntu
# Local: jdbc:postgresql://localhost:5432/ubuntu
# En compose la pisa el environment: de ubuntu-back (host postgres):
POSTGRES_URL=jdbc:postgresql://localhost:5432/ubuntu

## DATA SEEDING (seeders CommandLineRunner; compose la pisa a false) ##
APP_SEEDING_ENABLED=true

## GOOGLE OAuth (Authorization Code Flow; ambos obligatorios + redirect URI en Google Console) ##
GOOGLE_CLIENT_ID=Fill with Google client id
GOOGLE_CLIENT_SECRET=Fill with Google client secret
FRONTEND_POST_LOGIN_URL=Fill with frontend URL for post-login redirect

## CORS ##
FRONTEND_IP=http://ip:port
PROD_IP=KOYEB URL
# Opcional, default http://localhost:5173 en application.properties:
# FRONTEND_LOCAL=http://localhost:5173

## JWT ##
SECRET_KEY=Fill with a random generated key 256 bit

## CLOUDINARY ##
CLOUDINARY=cloudinary://PUBLIC API KEY:SECRET API KEY@CLOUD NAME

## EMAIL (requiere APP_MAIL_ENABLED=true + credenciales Gmail reales) ##
APP_MAIL_ENABLED=false
EMAIL_SENDER=Fill with sender email address
EMAIL_SENDER_PASSWORD=Fill with sender app password

## NOMINATIM (opcional, defaults publicos de OpenStreetMap en application.properties) ##
# NOMINATIM_SEARCH=https://nominatim.openstreetmap.org/search
# NOMINATIM_REVERSE=https://nominatim.openstreetmap.org/reverse
